OPENROUTER_API_KEY=your_key_here

# Solver — reasoning strategies (OpenRouter free tier or Ollama via OpenRouter)
SOLVER_MODEL=openrouter/free

# Judge — MUST differ from solver (anti-collusion, same pattern as Task 2 critic)
JUDGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Observability
TRACE_LOG_DIR=data/logs/traces

# Eval
BASELINE_PATH=data/baseline.json
GOLDEN_QUESTIONS_PATH=data/golden/gsm8k_test_35_questions.jsonl
GOLDEN_ANSWERS_PATH=data/golden/gsm8k_test_35_answers.jsonl

# Sandboxed code execution (Program-of-Thought)
CODE_EXEC_TIMEOUT=5.0
